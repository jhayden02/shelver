@model List<FloorPlan>
@{
    ViewData["Title"] = "Floor Plans";
}

@if (Model.Count == 0)
{
    <div class="floor-plan-empty">
        <a class="btn btn-primary" asp-action="Create">Create floor plan</a>
    </div>
}
else
{
    <p>
        <a class="btn btn-primary" asp-action="Create">Create floor plan</a>
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Size</th>
                <th>State</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (FloorPlan plan in Model)
            {
                <tr>
                    <td>@plan.Name</td>
                    <td>@LengthUnits.MillimetersToFeet(plan.WidthMm).ToString("0.##") &times; @LengthUnits.MillimetersToFeet(plan.HeightMm).ToString("0.##") ft</td>
                    <td>@plan.State</td>
                    <td><a asp-action="Edit" asp-route-id="@plan.Id">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>
}
