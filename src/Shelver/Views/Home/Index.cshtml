@model int
@{
    ViewData["Title"] = "Home";
    int readyFloorPlanCount = Model;
}

@if (readyFloorPlanCount == 0 && User.IsInRole(Roles.Administrator))
{
    <p>No floor plans are ready yet. Set one up in <a asp-controller="FloorPlans" asp-action="Index">Floor Plans</a>.</p>
}
else if (readyFloorPlanCount == 0)
{
    <p>No floor plans are ready yet. An Administrator sets them up.</p>
}
else
{
    <p>Viewing floor plans is coming soon.</p>
}
