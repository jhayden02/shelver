{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Shelver": "Data Source=App_Data/shelver.db"
  },
  "SignOutLimits": {
    "Auditor": {
      "IdleMinutes": 15,
      "AbsoluteHours": 12
    },
    "Administrator": {
      "IdleMinutes": 60,
      "AbsoluteHours": 12
    }
  }
}
